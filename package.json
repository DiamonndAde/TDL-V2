{
  "name": "tdl-website-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/verify.sh 1",
    "verify": "bash scripts/verify.sh 2",
    "verify:full": "bash scripts/verify.sh 3",
    "first-load": "cross-env MSYS_NO_PATHCONV=1 node scripts/first-load.mjs",
    "check:adapter": "node scripts/check-adapter.mjs",
    "test:guard": "bash scripts/placeholder-guard-proof.sh",
    "test:scroll": "bash scripts/serve-and-run.sh python scripts/scroll-proof.py",
    "test:slider": "bash scripts/slider-proof.sh",
    "test:reveal": "bash scripts/serve-and-run.sh python scripts/reveal-proof.py",
    "test:overflow": "bash scripts/serve-and-run.sh python scripts/overflow-proof.py",
    "test:form": "bash scripts/form-proof.sh",
    "test:links": "bash scripts/serve-and-run.sh python scripts/link-proof.py"
  },
  "dependencies": {
    "@oddbird/popover-polyfill": "0.7.3",
    "lucide-react": "1.54.0",
    "motion": "13.5.1",
    "next": "16.4.2",
    "posthog-js": "1.438.7",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
